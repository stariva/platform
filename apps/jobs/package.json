{
  "name": "@stariva/jobs",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "build": "bun build src/index.ts --target=node --external @hatchet-dev/typescript-sdk --outdir=dist",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "node dist/index.js",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.38.0",
    "@orpc/client": "2.0.0-beta.44",
    "@stariva/web-api": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stariva/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
