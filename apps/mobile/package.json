{
  "name": "@stariva/mobile",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache dist .turbo node_modules",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cap:sync": "vite build && cap sync",
    "apk:release": "bun scripts/release-apk.ts",
    "dev:android": "bun scripts/dev-android.ts",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "release": "bun run --filter @stariva/storage build && vite build && bun --env-file=../../.env scripts/release.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-updater": "^8.54.2",
    "@orpc/client": "2.0.0-beta.53",
    "@stariva/auth": "workspace:*",
    "@stariva/web-api": "workspace:*",
    "@tanstack/react-query": "^5.108.1",
    "hls.js": "^1.7.4",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@stariva/db": "workspace:*",
    "@stariva/storage": "workspace:*",
    "@stariva/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "0.8.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.1.0-dev.20261114.1",
    "vite": "^8.3.8"
  }
}
