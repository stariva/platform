{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".cache/tsbuildinfo.json",
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "migrate": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#db:generate": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": [
    "POSTGRES_URL",
    "APP_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_APP_SHORT_NAME",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "AUTH_REDIRECT_PROXY_URL",
    "AUTH_SECRET",
    "PORT",
    "RESEND_API_KEY",
    "EMAIL_PROVIDER",
    "EMAIL_FALLBACK_PROVIDER",
    "POSTBOX_ACCESS_KEY_ID",
    "POSTBOX_SECRET_ACCESS_KEY",
    "POSTBOX_ENDPOINT",
    "EMAIL_FROM",
    "EMAIL_SANDBOX_ENABLED",
    "EMAIL_SANDBOX_HOST",
    "AWS_S3_ENDPOINT",
    "AWS_S3_FORCE_PATH_STYLE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_S3_BUCKET",
    "HATCHET_CLIENT_TOKEN",
    "NEXT_PUBLIC_SITE_URL",
    "OZON_CLIENT_ID",
    "OZON_API_KEY",
    "YANDEX_METRIKA_TOKEN",
    "YANDEX_METRIKA_COUNTER_ID",
    "YANDEX_DIRECT_TOKEN",
    "YANDEX_DIRECT_CLIENT_LOGIN",
    "YANDEX_DIRECT_GOAL_IDS",
    "OZON_DELIVERY_ACCESS_TOKEN",
    "AI_API_KEY",
    "AI_BASE_URL",
    "AI_MODEL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "TELEGRAM_PROXY_URL",
    "ORDER_EMAIL_TO",
    "ORDER_EMAIL_FROM",
    "YOOKASSA_SHOP_ID",
    "YOOKASSA_SECRET_KEY",
    "LKNPD_PASSWORD",
    "LKNPD_AUTO_EMAIL"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
