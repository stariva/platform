{
  "$schema": "https://opencode.ai/config.json",

  // Biome ╤Д╨╛╤А╨╝╨░╤В╨╕╤А╤Г╨╡╤В ╨║╨╛╨┤ ╨╕ JSON ╨┐╨╛╤Б╨╗╨╡ write/edit/patch.
  // Markdown ╨╕╤Б╨║╨╗╤О╤З╤С╨╜: Biome ╨╗╨╛╨╝╨░╨╡╤В YAML frontmatter ╤Г ╤Б╨║╨╕╨╗╨╗╨╛╨▓ ╨╕ ╨║╨╛╨╝╨░╨╜╨┤.
  "formatter": {
    "biome": {
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".scss",
        ".sass",
        ".less"
      ]
    }
  },

  // ╨Э╨╡ ╨╕╨╜╨┤╨╡╨║╤Б╨╕╤А╨╛╨▓╨░╤В╤М ╨┤╤Г╨▒╨╗╨╕╤А╤Г╤О╤Й╨╕╨╡ checkout'╤Л ╨╕ ╨░╤А╤В╨╡╤Д╨░╨║╤В╤Л ╤Б╨▒╨╛╤А╨║╨╕.
  "watcher": {
    "ignore": [
      ".claude/worktrees/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.turbo/**",
      "**/.cache/**",
      "**/android/app/build/**"
    ]
  },

  "permissions": [
    // --- ╨б╨╡╨║╤А╨╡╤В╤Л: ╨╜╨╡ ╤З╨╕╤В╨░╨╡╨╝ ╨╕ ╨╜╨╡ ╨┐╤А╨░╨▓╨╕╨╝ ---
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    {
      "action": "read",
      "resource": "*google-services.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*GoogleService-Info.plist",
      "effect": "deny"
    },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.keystore", "effect": "deny" },
    { "action": "edit", "resource": "*.jks", "effect": "deny" },
    {
      "action": "edit",
      "resource": "*google-services.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*GoogleService-Info.plist",
      "effect": "deny"
    },

    // ╨Ь╨╕╨│╤А╨░╤Ж╨╕╨╕ ╨│╨╡╨╜╨╡╤А╨╕╤А╤Г╨╡╤В drizzle-kit. ╨а╤Г╤З╨╜╨░╤П ╨┐╤А╨░╨▓╨║╨░ тАФ ╤В╨╛╨╗╤М╨║╨╛ ╤Б ╨┐╨╛╨┤╤В╨▓╨╡╤А╨╢╨┤╨╡╨╜╨╕╨╡╨╝
    // (╨╜╨░╨┐╤А╨╕╨╝╨╡╤А, ╨┤╨╛╨▒╨░╨▓╨╕╤В╤М -- migrate:non-transactional).
    {
      "action": "edit",
      "resource": "packages/db/migrations/*",
      "effect": "ask"
    },
    // Lock-╤Д╨░╨╣╨╗ ╨╝╨╡╨╜╤П╨╡╤В ╤В╨╛╨╗╤М╨║╨╛ bun install.
    { "action": "edit", "resource": "bun.lock", "effect": "deny" },

    // --- ╨Ю╨┐╨░╤Б╨╜╤Л╨╡ ╨║╨╛╨╝╨░╨╜╨┤╤Л: ╤Б╨┐╤А╨░╤И╨╕╨▓╨░╨╡╨╝ ---
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "bun db:push*", "effect": "ask" },
    { "action": "shell", "resource": "bun run db:push*", "effect": "ask" },
    { "action": "shell", "resource": "bun db:migrate*", "effect": "ask" },
    { "action": "shell", "resource": "bun run db:migrate*", "effect": "ask" },
    {
      "action": "shell",
      "resource": "bun --filter @stariva/db drop*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bunx drizzle-kit push*",
      "effect": "ask"
    },
    { "action": "shell", "resource": "bunx drizzle-kit drop*", "effect": "ask" }
  ],

  "mcp": {
    "servers": {
      // ╨б╨▓╨╡╨╢╨░╤П ╨┤╨╛╨║╤Г╨╝╨╡╨╜╤В╨░╤Ж╨╕╤П ╨▒╨╕╨▒╨╗╨╕╨╛╤В╨╡╨║: Next 16, React 19, Capacitor 8, oRPC 2,
      // Tailwind 4, Drizzle. ╨Ъ╨╗╤О╤З ╨╜╨╡ ╤Е╤А╨░╨╜╨╕╨╝ ╨▓ ╤А╨╡╨┐╨╛: ╨╖╨░╨┤╨░╨╣╤В╨╡ CONTEXT7_API_KEY.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "ctx7sk-a35f047f-2c6d-4b28-82ec-7caaf5949b9d"
        }
      },

      // ╨з╨╕╤Б╤В╤Л╨╣ ╨┐╤А╨╛╤Д╨╕╨╗╤М ╨▒╤А╨░╤Г╨╖╨╡╤А╨░ ╨┤╨╗╤П ui-qa: ╨╝╨╛╨▒╨╕╨╗╤М╨╜╤Л╨╡ ╨▓╤М╤О╨┐╨╛╤А╤В╤Л, ╤Б╨║╤А╨╕╨╜╤И╨╛╤В╤Л,
      // ╨║╨╛╨╜╤Б╨╛╨╗╤М ╨╕ ╤Б╨╡╤В╤М. ╨Э╨╡ ╨║╨╛╨╜╤Д╨╗╨╕╨║╤В╤Г╨╡╤В ╤Б ╨┐╨╛╨╗╤М╨╖╨╛╨▓╨░╤В╨╡╨╗╤М╤Б╨║╨╕╨╝ Chrome.
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "@playwright/mcp@latest",
          "--output-dir",
          ".cache/playwright-mcp"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
