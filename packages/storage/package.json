{
  "name": "@stariva/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "cors": "bun --env-file=../../.env src/scripts/set-bucket-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@stariva/config": "workspace:*"
  },
  "devDependencies": {
    "@stariva/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  }
}
