{
  "name": "@stariva/emails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    ".react-email"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev:email": "bun --env-file=../../.env run email dev -p 3002",
    "build": "tsdown",
    "export": "email export",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@react-email/components": "1.0.12",
    "@stariva/config": "workspace:*",
    "@tailwindcss/typography": "0.5.20",
    "nodemailer": "^10.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@stariva/tsconfig": "workspace:*",
    "@types/node": "26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
