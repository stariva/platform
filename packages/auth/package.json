{
  "name": "@stariva/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./cors": "./src/cors.ts",
    "./origins": "./src/origins.ts",
    "./env": "./env.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "generate": "bun --env-file=../../.env x @better-auth/cli generate --config script/auth-cli.ts --output ../db/src/auth-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@stariva/config": "workspace:*",
    "@stariva/db": "workspace:*",
    "better-auth": "1.7.25",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@stariva/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "typescript": "7.1.0-dev.20261114.1"
  }
}
